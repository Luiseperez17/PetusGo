# Copia a ".env" (junto a docker-compose.yml). Nunca lo subas a git.

# ── Backend ──
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
# Origen EXACTO del frontend (sin "/" final). Local con compose: http://localhost:8080
CORS_ORIGIN="http://localhost:8080"

# ── Frontend (se incrusta al construir la imagen) ──
# URL pública del backend, terminando en /api. Producción: https://api.tudominio.com/api
VITE_API_URL="http://localhost:3001/api"
